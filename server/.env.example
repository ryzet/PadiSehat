# Salin menjadi server/.env. Jangan commit file .env.
NODE_ENV=development
PORT=3000

# Koneksi runtime API: gunakan role PostgreSQL khusus non-superuser/non-BYPASSRLS.
DATABASE_URL=postgresql://padisehat_app:APP_PASSWORD@localhost:5432/padisehat
DATABASE_SSL=false

# Koneksi admin khusus untuk menjalankan migrasi. Jangan gunakan untuk API runtime.
MIGRATION_DATABASE_URL=postgresql://postgres:ADMIN_PASSWORD@localhost:5432/padisehat

# Minimal 32 karakter acak. Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-this-with-at-least-32-random-characters
SESSION_COOKIE_NAME=padisehat.sid
SESSION_MAX_AGE_MS=604800000

# Origin frontend Vite saat pengembangan. Di produksi isi origin HTTPS frontend.
FRONTEND_ORIGIN=http://localhost:5173

# Aktifkan hanya jika API berada di belakang reverse proxy tepercaya.
TRUST_PROXY=false
